5. Área de superficie
f(x)=x^2,        g(x)=x^2−2x+4



import numpy as np
import matplotlib.pyplot as plt

x = np.linspace(0, 2, 1000)

f = x**2
g = x**2 - 2*x + 4

plt.figure(figsize=(7,5))

plt.plot(x, f, label=r'$f(x)=x^2$')
plt.plot(x, g, label=r'$g(x)=x^2-2x+4$')

plt.fill_between(x, f, g, alpha=0.3)

plt.xlabel('x')
plt.ylabel('y')

plt.title('Área entre curvas')

plt.legend()
plt.grid(True)

plt.show()
