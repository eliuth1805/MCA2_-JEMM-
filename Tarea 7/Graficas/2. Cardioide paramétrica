2. Cardioide paramétrica



import numpy as np
import matplotlib.pyplot as plt

a = 1
t = np.linspace(0, 2*np.pi, 1000)

x = a*(2*np.cos(t) - np.cos(2*t))
y = a*(2*np.sin(t) - np.sin(2*t))

plt.figure(figsize=(6,6))

plt.plot(x, y)

plt.fill(x, y, alpha=0.3)

plt.axis('equal')

plt.title('Cardioide')
plt.grid(True)

plt.show()
